# Receipt-First has no secrets. There is no server, no database and no API key.
# This is the only setting, and it is optional.

# Devnet RPC endpoint used when the browser has no override stored.
# The public endpoint below rate-limits airdrops hard; point this at your own
# devnet RPC if you have one. The app refuses to run against mainnet-beta
# regardless of what you put here — it checks the cluster's genesis hash.
VITE_SOLANA_RPC=https://api.devnet.solana.com
